{
    "XREVRANGE": {
        "summary": "Returns the messages from a stream within a range of IDs in reverse order.",
        "complexity": "O(N) with N being the number of entries returned without FILTER. With FILTER, MAXSCAN bounds examined entries (default 1000), including deleted entries; each live entry also incurs expression evaluation and field lookup cost. Result limits count matches.",
        "group": "stream",
        "since": "5.0.0",
        "arity": -4,
        "function": "xrevrangeCommand",
        "history": [
            [
                "6.2.0",
                "Added exclusive ranges."
            ]
        ],
        "command_flags": [
            "READONLY"
        ],
        "acl_categories": [
            "STREAM"
        ],
        "key_specs": [
            {
                "flags": [
                    "RO",
                    "ACCESS"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "arguments": [
            {
                "name": "key",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "end",
                "type": "string"
            },
            {
                "name": "start",
                "type": "string"
            },
            {
                "token": "COUNT",
                "name": "count",
                "type": "integer",
                "optional": true
            },
            {
                "token": "FILTER",
                "name": "expression",
                "type": "string",
                "optional": true
            },
            {
                "token": "MAXSCAN",
                "name": "maxscan",
                "type": "integer",
                "optional": true
            }
        ],
        "reply_schema": {
            "oneOf": [
                {
                    "description": "An array of the entries with IDs matching the specified range",
                    "type": "array",
                    "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": [
                            {
                                "description": "Stream id",
                                "type": "string",
                                "pattern": "[0-9]+-[0-9]+"
                            },
                            {
                                "description": "Array of field-value pairs",
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        ]
                    }
                },
                {
                    "description": "With FILTER: entries, scan progress and termination status. RESP2 encodes the map as alternating keys and values.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "entries": {
                            "description": "An array of the entries with IDs matching the specified range",
                            "type": "array",
                            "items": {
                                "type": "array",
                                "minItems": 2,
                                "maxItems": 2,
                                "items": [
                                    {
                                        "description": "Stream id",
                                        "type": "string",
                                        "pattern": "[0-9]+-[0-9]+"
                                    },
                                    {
                                        "description": "Array of field-value pairs",
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                ]
                            }
                        },
                        "last_scanned": {
                            "description": "Last examined ID (including deleted and rejected entries), or null if no entry was examined.",
                            "oneOf": [
                                {
                                    "type": "string",
                                    "pattern": "[0-9]+-[0-9]+"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "status": {
                            "type": "string",
                            "oneOf": [
                                {
                                    "const": "exhausted"
                                },
                                {
                                    "const": "count_reached"
                                },
                                {
                                    "const": "budget_exhausted"
                                }
                            ]
                        }
                    }
                }
            ]
        }
    }
}
