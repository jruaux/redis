{
    "XCFGSET": {
        "summary": "Sets stream configuration, including experimental sealed-block compression.",
        "complexity": "O(1) with bounded dictionary validation (at most 65536 bytes and 16 retained generations).",
        "group": "stream",
        "since": "8.6.0",
        "arity": -2,
        "function": "xcfgsetCommand",
        "command_flags": [
            "WRITE",
            "FAST"
        ],
        "acl_categories": [
            "STREAM"
        ],
        "reply_schema": {
            "const": "OK"
        },
        "key_specs": [
            {
                "flags": [
                    "RW",
                    "UPDATE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "arguments": [
            {
                "name": "key",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "idmp-duration",
                "type": "integer",
                "token": "IDMP-DURATION",
                "optional": true
            },
            {
                "name": "idmp-maxsize",
                "type": "integer",
                "token": "IDMP-MAXSIZE",
                "optional": true
            },
            {
                "name": "compression",
                "type": "oneof",
                "optional": true,
                "token": "COMPRESSION",
                "arguments": [
                    {
                        "name": "off",
                        "type": "pure-token",
                        "token": "OFF"
                    },
                    {
                        "name": "zstd",
                        "type": "pure-token",
                        "token": "ZSTD"
                    }
                ]
            },
            {
                "name": "dictionary",
                "type": "string",
                "token": "DICTIONARY",
                "optional": true
            }
        ]
    }
}
